# Copy to .env and adjust. None of these are secrets.

# The address people type to open the tracker. Used to build invite links.
TT_BASE_URL=http://ddtaskserver:8080

# Host port to publish. Use 127.0.0.1:8080 if a reverse proxy (nginx, Caddy, IIS) sits in front.
TT_PUBLISH=8080

# Set both to 1 when the tracker is served over HTTPS through a reverse proxy.
TT_COOKIE_SECURE=0
TT_TRUST_PROXY=0

# Server time zone: decides "today" for Delay status and the archive rule.
TZ=Asia/Kuala_Lumpur

# Completed tasks move to the Archive this many days after their actual date.
TT_ARCHIVE_DAYS=2
