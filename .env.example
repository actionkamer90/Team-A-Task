# Copy this file to .env and change the values.

# Port on the server where the tracker is reachable (http://ddtaskserver:80/).
HTTP_PORT=80

# Time zone used to decide "today" for archiving.
TZ=Asia/Kuala_Lumpur

# First admin account. Only used the very first time the tracker starts.
# Leave ADMIN_PASSWORD empty to have a random one printed in the logs.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Set both to true when the tracker sits behind HTTPS (e.g. an Nginx reverse proxy).
COOKIE_SECURE=false
TRUST_PROXY=false
